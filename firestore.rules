rules_version = '2';

// כללי Firestore (לא פורסמו לפרויקט – בדיקה באמולטור בלבד עד אישור).
// עיקרון: ברירת מחדל סגורה.
//  - מורה מחובר: קורא את המאגר המרכזי, יוצר הצעות על שמו בלבד (בסטטוס pending), קורא רק את ההצעות שלו.
//  - מנהל: קיים מסמך admins/{uid} (נוצר ידנית בקונסולה; אף לקוח לא יכול לכתוב אליו). רק מנהל כותב למאגר, מעדכן הצעות וכותב יומן ביקורת.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // הרשאת מנהל: משתמש יכול לבדוק רק את המסמך של עצמו. כתיבה ורשימה אסורות לכולם.
    match /admins/{uid} {
      allow get: if isOwner(uid);
      allow list, write: if false;
    }

    // המאגר המרכזי – תוכן מפורסם בלבד: meta ציבורי, חבילות שאלות וסיפורי מקרה של שאלות מפורסמות.
    // קריאה למחוברים, כתיבה למנהל בלבד. שאלות מוסתרות/טיוטות לעולם אינן נשמרות כאן (ראו bankPrivate).
    match /bank/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // תוכן מוסתר/לא מפורסם (שאלות מוסתרות, מקרים ואיורים שלהן): מנהל בלבד, קריאה וכתיבה.
    match /bankPrivate/{docId} {
      allow read, write: if isAdmin();
    }

    // איורי המאגר המרכזי (חלקים עד ~800KB). מורה קורא רק חלק שדגל pub שלו true (איור של שאלה מפורסמת); מנהל קורא הכול.
    // קריאה ישירה לכל מסמך שאינו pub נחסמת; רשימה (list) מותרת למורה רק בשאילתה שמסננת pub==true.
    match /bankMedia/{docId} {
      allow read: if isAdmin() || (signedIn() && resource.data.get('pub', false) == true);
      allow write: if isAdmin();
    }

    // הצעות שאלות. יצירה: הבעלים בלבד, סטטוס pending בלבד, ללא שדות מיותרים.
    // קריאה: הבעלים או מנהל. עדכון/מחיקה (אישור, דחייה): מנהל בלבד. מורה לא יכול לשנות הצעה אחרי שליחתה.
    match /suggestions/{id} {
      allow create: if isOwner(request.resource.data.authorUid)
        && request.resource.data.keys().hasOnly(['id', 'status', 'authorUid', 'credit', 'authorName', 'submittedAt', 'questionJson', 'imageKeys', 'mediaTag'])
        && request.resource.data.keys().hasAll(['id', 'status', 'authorUid', 'credit', 'authorName', 'submittedAt', 'questionJson'])
        && request.resource.data.id == id
        && request.resource.data.status == 'pending'
        && request.resource.data.credit is bool
        && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 100
        && request.resource.data.questionJson is string && request.resource.data.questionJson.size() <= 900000
        && (!('imageKeys' in request.resource.data) || (request.resource.data.imageKeys is list && request.resource.data.imageKeys.size() <= 20));
      allow get, list: if signedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // תמונות של הצעות (המנהל לא יכול לקרוא Drive של מורה, לכן המורה שולח עותק של התמונה עם ההצעה).
    match /suggestionMedia/{id} {
      allow create: if isOwner(request.resource.data.authorUid)
        && request.resource.data.keys().hasOnly(['sgId', 'authorUid', 'key', 'part', 'parts', 'data', 'tag'])
        && request.resource.data.sgId is string && request.resource.data.sgId.matches('^sg-[A-Za-z0-9_.:-]{1,150}$')
        && request.resource.data.key is string && request.resource.data.key.size() > 0 && request.resource.data.key.size() <= 300
        && request.resource.data.tag is string && request.resource.data.tag.size() > 0 && request.resource.data.tag.size() <= 20
        && request.resource.data.part is int && request.resource.data.parts is int
        && request.resource.data.parts >= 1 && request.resource.data.parts <= 20
        && request.resource.data.part >= 0 && request.resource.data.part < request.resource.data.parts
        && request.resource.data.tag.matches('^[A-Za-z0-9]{1,20}$')
        && id.matches('^' + request.resource.data.sgId + '-' + request.resource.data.tag + '-.*-' + string(request.resource.data.part) + '$')   // מזהה המסמך קשור להצעה, לשליחה ולמספר החלק
        && request.resource.data.data is bytes && request.resource.data.data.size() <= 900000;
      allow get, list: if signedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // יומן ביקורת של פעולות מנהל: יצירה בלבד, ללא עדכון/מחיקה.
    match /audit/{id} {
      allow create: if isAdmin() && request.resource.data.by == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // כל השאר סגור.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

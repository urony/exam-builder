rules_version = '2';

// כללי Firestore (טיוטה לבדיקה – לא פורסמו לפרויקט).
// עיקרון: ברירת מחדל סגורה. מורה מחובר קורא את המאגר המרכזי ומציע שאלות; רק מנהל כותב למאגר.
// מנהל = קיים מסמך admins/{uid}. המסמך נוצר ידנית בקונסולה; אף לקוח לא יכול לכתוב אליו.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // הרשאת מנהל: משתמש יכול לבדוק רק את המסמך של עצמו. כתיבה אסורה.
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // המאגר המרכזי (חבילות נתונים של שאלות, סיפורי מקרה, סיווגים, איורים): קריאה למחוברים, כתיבה למנהל.
    match /bank/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // הצעות שאלות: המורה יוצר הצעה על שמו בלבד, בסטטוס pending, וקורא רק את שלו; המנהל קורא ומעדכן הכול.
    match /suggestions/{id} {
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow get, list: if signedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // כל השאר סגור.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
